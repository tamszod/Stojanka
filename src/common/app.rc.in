// Windows resources (icon + version details shown in the file's Properties). Generated by CMake.
#include <winver.h>

// 32512 is IDI_APPLICATION: Explorer uses the first icon, and the installer window loads this ID.
32512 ICON "@STROJANKA_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Strojanka"
            VALUE "FileDescription",  "@RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@RC_NAME@"
            VALUE "OriginalFilename", "@RC_NAME@.exe"
            VALUE "ProductName",      "Strojanka"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
